{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "default"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "screenshots": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO_TOOLS": "1"
      },
      "channel": "screenshots"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6836394392"
      }
    }
  }
}
